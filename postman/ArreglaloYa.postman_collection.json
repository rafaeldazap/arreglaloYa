          "name": "Login Cliente (Auto-guarda JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.environment.set('token_cliente', res.access_token);",
                  "    pm.collectionVariables.set('token_cliente', res.access_token);",
                  "    console.log('✅ Token Cliente guardado:', res.access_token.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente@demo.com\",\n  \"contrasena\": \"123456\"\n}"
