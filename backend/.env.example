PORT=8080
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_DATABASE=postgres

# Seguridad JWT (use una clave aleatoria larga en producción)
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_LARGO_Y_ALEATORIO
JWT_EXPIRATION=86400s

# Orígenes CORS permitidos separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Carpeta local de archivos subidos
UPLOAD_DIR=uploads
