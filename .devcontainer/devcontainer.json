{
  "name": "Arreglalo Ya",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "cd frontend && npm install && npx ng analytics disable --global && cd ../backend && npm install",
  "forwardPorts": [4200, 3000],
  "portsAttributes": {
    "4200": { "label": "Frontend Angular", "onAutoForward": "openPreview" },
    "3000": { "label": "Backend NestJS" }
  }
}
